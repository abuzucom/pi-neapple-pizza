# Preserve LF source and configuration bytes across platform checkouts.
* text=auto eol=lf

# Keep policy inputs within the byte limit on every platform.
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
GEMINI.md text eol=lf
CONVENTIONS.md text eol=lf
.cursorrules text eol=lf
.clinerules text eol=lf
.windsurfrules text eol=lf
.copilot-instructions text eol=lf
.github/copilot-instructions.md text eol=lf
docs/agent-policy/*.md text eol=lf

# pi runtime entries from earendil-works/pi v1.5.2.
# Windows command interpreters require CRLF line endings in batch and PowerShell scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts require LF line endings.
*.sh text eol=lf

# Archived patch artifacts preserve whitespace exactly.
packages/agent/docs/**/*.diff -whitespace

# Common binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
